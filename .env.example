# ── AI provider ───────────────────────────────────────────────
# 키가 하나도 없으면 backend/ai/ 가 목업으로 동작합니다 (데모는 끝까지 돌아갑니다).

# Upstage (기본) — Solar 채팅 + Document Parse + 임베딩
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro4

# Anthropic (선택) — 쓰려면 AI_PROVIDER=anthropic 도 함께
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# upstage | anthropic | mock — 비워두면 있는 키로 자동 판정
# AI_PROVIDER=

# ── 주소 (로컬 실행 ./run.sh 용) ───────────────────────────────
PATIENT_BASE_URL=http://localhost:8000
REHABTALK_API=http://localhost:8000

# ── docker compose 포트 (다른 프로젝트와 겹칠 때만 바꾸세요) ────
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
